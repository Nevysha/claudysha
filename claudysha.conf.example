# claudysha settings. install.sh copies this file to ~/.config/claudysha/claudysha.conf
# (or $XDG_CONFIG_HOME/claudysha/claudysha.conf) if it doesn't exist yet: edit that copy.
# Lines are `key = value`; `#` starts a comment.

# The data folder, where every module keeps its data (see the README).
home = ~/.claudysha

# Who Claude works with. Used by the modules (prompts, session notes).
user_name = Nevysha
user_pronouns = she/her

# Memory module: projects to file memories under, comma-separated (optional).
projects =

# Memory module: during a session, extract memories once this many new transcript lines
# piled up (checked after each reply). 0 turns it off: extraction then only runs at
# compaction and at the end of the session.
# memory_every_lines = 300
